{
    "name": "masilia/editorial-toolbox",
    "description": "In-context editorial toolbox for Ibexa: front-end edit toolbar, block sidebar and the JSON API behind them",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ibexa/core": "^4.6 || ^5.0",
        "ibexa/admin-ui": "^4.6 || ^5.0",
        "symfony/framework-bundle": "^5.4 || ^6.4 || ^7.0",
        "symfony/event-dispatcher": "^5.4 || ^6.4 || ^7.0",
        "symfony/http-foundation": "^5.4 || ^6.4 || ^7.0",
        "symfony/routing": "^5.4 || ^6.4 || ^7.0",
        "symfony/security-csrf": "^5.4 || ^6.4 || ^7.0",
        "symfony/translation-contracts": "^2.5 || ^3.0",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0",
        "phpstan/phpstan": "^1.10 || ^2.0"
    },
    "autoload": {
        "psr-4": {
            "Masilia\\EditorialToolbox\\": "src/lib/",
            "Masilia\\Bundle\\EditorialToolbox\\": "src/bundle/",
            "Masilia\\Contracts\\EditorialToolbox\\": "src/contracts/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Masilia\\Tests\\EditorialToolbox\\": "tests/lib/",
            "Masilia\\Tests\\Bundle\\EditorialToolbox\\": "tests/bundle/"
        }
    },
    "scripts": {
        "test": ["@phpunit"],
        "phpunit": "phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0-dev"
        }
    }
}
